# SMTP for notification emails
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ies.info@iliauni.edu.ge
MAIL_PASSWORD=

# ies_borders MySQL database used by automatic earthquake processing
BORDERS_DB_HOST=127.0.0.1
BORDERS_DB_USER=ies_borders
BORDERS_DB_PASSWORD=
BORDERS_DB_NAME=ies_borders

# SeisComP MySQL database (events, origins, magnitudes)
SC_DB_HOST=127.0.0.1
SC_DB_USER=sysop
SC_DB_PASSWORD=
SC_DB_NAME=seiscomp
# Retries while scdb has not yet written a new event
SC_DB_RETRIES=5
SC_DB_RETRY_DELAY=3

# Recipients list, relative to this folder; refreshed by recipients/update_recipients.py
RECIPIENTS_FILE=recipients/email_recipients.json
SMS_RECIPIENTS_FILE=recipients/sms_recipients.json

# iesdata API with the recipients (recipients/update_recipients.py)
Recp_Exporter_API_URL=https://iesdata.iliauni.edu.ge:3030/
Recp_Exporter_API_KEY=
# Only for a self-signed server certificate; by default the system CAs are used
# Recp_Exporter_API_CA=recipients/server_ca.pem
# Recp_Exporter_API_TIMEOUT=20

# iesdata API where every notified event is added (send_eq2api/send_eq2api.py)
Send_eq2api_API_URL=https://iesdata.iliauni.edu.ge:3030/
Send_eq2api_API_KEY=
# Separate service key with can_event_publish; used when publish_iliauni=True
SeisComp_Publisher_API_KEY=
# Only for a self-signed server certificate; by default the system CAs are used
# Send_eq2api_API_CA=recipients/server_ca.pem
# Send_eq2api_API_TIMEOUT=20

# Notification channels (0 turns one off)
SEND_EMAIL=1
SEND_SMS=1
SEND_EQ2API=1

# SMS gateways, tried in this order; each gets only the numbers the previous one
# failed to reach. A gateway with empty credentials is skipped.
SMS_PROVIDERS=magti,smsoffice,gsm
# SMS_TIMEOUT=10
# MAGTI_URL=http://81.95.160.47/mt/oneway
# MAGTI_TRACK_URL=http://81.95.160.47/bi/track.php
MAGTI_USERNAME=
MAGTI_PASSWORD=
MAGTI_CLIENT_ID=643
MAGTI_SERVICE_ID=1
# SMSOFFICE_URL=https://smsoffice.ge/api/v2/send/
# SMSOFFICE_BALANCE_URL=https://smsoffice.ge/api/getBalance
SMSOFFICE_KEY=
SMSOFFICE_SENDER=IES
# Log "SMS BALANCE LOW" at or below this many SMS
SMSOFFICE_BALANCE_WARNING=5000
GSM_SMS_URL=http://iesresource.iliauni.edu.ge/block/ies_gsm_sms_sender.php
GSM_SMS_CODE=

# LOG_FILE=logs/event_scalert.log
LOG_LEVEL=INFO
# 1 = decide and log, send nothing
# DRY_RUN=1
